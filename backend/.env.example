# --- LLM ---
# Get a free key at https://aistudio.google.com/apikey, then paste it
# below. Used by the Planning Agent (AI roadmap generation) and the
# scripts/enrich_resume_value.py enrichment script — nothing else needs
# it. Never commit a real key: this .env file should stay out of git
# (check .gitignore) and only .env.example (with a blank key) is tracked.
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-flash-latest

# --- Database ---
# SQLite by default (a plain file, hackbase.db, created automatically on
# first run — no server to install). Switch to a real Postgres URL here
# if/when you want one; app/db/session.py handles either transparently.
DATABASE_URL=sqlite:///./hackbase.db

# --- Auth ---
# Generate a real value with: python -c "import secrets; print(secrets.token_hex(32))"
# The default in app/core/config.py is only safe for local dev.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# --- Vector store ---
VECTOR_STORE_PROVIDER=chroma          # chroma | faiss
CHROMA_PERSIST_DIR=./data/processed/chroma

# --- Embeddings (see app/rag/embeddings.py) ---
# "sentence-transformers" (default, best quality) downloads its model
# weights from huggingface.co the first time it runs. If huggingface.co
# isn't reachable from your machine/network, set this to "spacy" instead
# (fully local after `pip install -r requirements.txt`, no runtime
# download, lower semantic quality). Whichever you pick, run
# `python -m app.rag.index_builder` afterwards to (re)build the index —
# each provider gets its own Chroma collection, so switching is safe.
EMBEDDING_PROVIDER=sentence-transformers   # sentence-transformers | spacy
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
SPACY_MODEL_NAME=en_core_web_md

# --- MLflow ---
MLFLOW_TRACKING_URI=./mlflow

# --- App ---
APP_ENV=development
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173
