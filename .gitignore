# Python
__pycache__/
*.pyc
venv/
.venv/
*.egg-info/
.pytest_cache/

# Env
.env

# Node
node_modules/
dist/

# Data / experiments
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
# The deployed backend (Render) builds straight from this repo, so the
# app's actual content has to be committed or production starts empty.
# The Chroma index is NOT committed — it's rebuilt at deploy time from
# problems.json (python -m app.rag.index_builder in Render's build command).
!data/processed/problems.json
!data/processed/live_hackathons.json
mlflow/*
!mlflow/.gitkeep
# The pair above is root-anchored (contains a "/", so git only matches it
# at the repo root) and misses backend/mlflow/ — the directory MLflow
# actually writes to when the backend runs from backend/ (see
# app/core/tracking.py). Real incident: 973 experiment-run files sat
# untracked here, one `git add -A` away from being committed.
backend/mlflow/*
!backend/mlflow/.gitkeep

# Database (generated locally, not source code)
*.db

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/

.vercel
